      "term": "Tailgating",
      "anchor": "#definition",
      "definition": "Unauthorized entry by following an authorized person through an access point."
    },
    {
      "term": "Security vestibule",
      "anchor": "#controls",
      "definition": "Two interlocked doors that admit one person at a time, also called a mantrap."
    },
    {
      "term": "Anti-passback",
      "anchor": "#controls",
      "definition": "Rejects a badge used for entry twice without an exit."
    }
