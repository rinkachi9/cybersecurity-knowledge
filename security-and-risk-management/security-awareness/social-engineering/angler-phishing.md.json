  "concepts": [
    {
      "term": "Angler phishing",
      "anchor": "#definition",
      "definition": "Phishing in which fake customer support accounts on social media answer customers who asked a brand for help."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "How does angler phishing differ from email phishing?",
      "a": "The victim starts the contact by asking a brand for help; the attacker replies as fake support.",
      "anchor": "#definition",
      "origin": "ai"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why does SMS MFA not stop it?",
      "a": "The attacker relays the code in real time from the fake page.",
