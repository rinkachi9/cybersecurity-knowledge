  "concepts": [
    {
      "term": "Threat modeling",
      "anchor": "#definition",
      "definition": "Analyzing representations of a system to highlight concerns about security and privacy characteristics."
    },
    {
      "term": "Trust boundary",
      "anchor": "#definition",
      "definition": "A place where the level of trust, privilege or ownership changes."
    },
    {
      "term": "Data flow diagram",
      "anchor": "#the-model-data-flow-diagrams",
      "definition": "Model with external entities, processes, data stores, data flows and trust boundaries."
    }
