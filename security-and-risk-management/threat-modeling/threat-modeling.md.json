  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What are the four questions of threat modeling?",
      "a": "What are we working on? What can go wrong? What are we going to do about it? Did we do a good enough job?",
      "anchor": "#the-four-questions",
      "origin": "ai"
    },
    {
      "id": "q2",
      "type": "compare",
      "q": "Distinguish threat, vulnerability and attack.",
      "a": "Threat: potential undesirable occurrence. Vulnerability: characteristic that makes it possible. Attack: action that exploits a vulnerability to enact the threat.",
      "anchor": "#definition",
      "origin": "ai"
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "Name the four responses to a threat.",
      "a": "Mitigate, eliminate, transfer, accept.",
      "anchor": "#responses-to-a-threat",
      "origin": "ai"
    }
