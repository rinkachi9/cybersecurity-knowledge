  "concepts": [
    {
      "term": "Defense in depth",
      "anchor": "#definition",
      "definition": "Several independent controls between a threat and an asset so that one failure does not cause a full compromise."
    },
    {
      "term": "Common-mode failure",
      "anchor": "#mechanism-why-independent-layers-multiply-protection",
      "definition": "A single cause that defeats several layers at once, such as a shared administrator credential."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why does adding layers stop helping when layers share a common-mode failure?",
      "a": "The pass probability c + (1 - c) q^n cannot fall below c, the chance of a bypass that defeats every layer at once.",
      "anchor": "#mechanism-why-independent-layers-multiply-protection",
      "origin": "ai"
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "Four security products are all administered through one SSO account without MFA. How many independent layers exist against an attacker who phishes that account?",
      "a": "Effectively one, because the account can disable all four.",
      "anchor": "#common-mistakes",
      "origin": "ai"
    },
    {
      "id": "q3",
      "type": "compare",
      "q": "How does defense in depth differ from defense in breadth?",
      "a": "Depth stacks several controls on one attack path, breadth covers every attack path with at least one control.",
      "anchor": "#definition",
      "origin": "ai"
    }
  ],
